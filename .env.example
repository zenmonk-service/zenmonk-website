# Website
APP_BIND_ADDRESS=0.0.0.0
APP_FORWARD_PORT=3000
APP_URL=http://localhost:3000

# MongoDB application account
DB_USER=zenmonk_app
DB_PASSWORD=replace-with-a-strong-app-password
DB_HOST=mongodb
DB_PORT=27017
DB_NAME=zenmonk-website
# Keep this equal to DB_NAME when using the bundled MongoDB bootstrap service.
DB_AUTH_SOURCE=zenmonk-website

# MongoDB administrator account (used by MongoDB initialization and Mongo Express)
MONGO_ROOT_USER=zenmonk_root
MONGO_ROOT_PASSWORD=replace-with-a-strong-root-password

# Development-only host access
DB_FORWARD_PORT=27017
MONGO_EXPRESS_FORWARD_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=replace-with-a-strong-dashboard-password

# SMTP. These defaults target the bundled MailHog service.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=ZenMonk Careers <careers@zenmonk.com>
MAIL_FORWARD_PORT=1025
MAIL_DASHBOARD_FORWARD_PORT=8025

# Optional: use a managed/external MongoDB connection instead of the DB_* values.
# MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/zenmonk-website
